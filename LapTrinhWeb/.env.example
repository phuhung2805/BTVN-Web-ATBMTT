# Copy file này thành .env nếu muốn đổi giá trị:  cp .env.example .env
# (.env đã nằm trong .gitignore, KHÔNG commit token lên GitHub)
# Không có file .env thì vẫn chạy được với giá trị mặc định bên dưới.

# 2 tên miền cho 2 website.
# Mặc định *.localhost: trình duyệt tự trỏ về máy mình, không cần mua domain, không sửa file hosts.
# Khi có domain thật thì đổi thành vd: web1.tenmiencuaban.com / web2.tenmiencuaban.com
DOMAIN1=web1.localhost
DOMAIN2=web2.localhost

# Chỉ cần khi dùng domain thật (docker compose --profile domain-that up -d)
# Lấy tại: Cloudflare Zero Trust > Networks > Tunnels > Create tunnel (Cloudflared)
CLOUDFLARE_TUNNEL_TOKEN=YOUR_TUNNEL_TOKEN
